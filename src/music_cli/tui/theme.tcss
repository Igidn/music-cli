/* Colors come from the active Textual theme (Ctrl+P → Theme); the default
   "music-cli" theme is registered in app.py and matches the original palette. */

Screen {
    background: $background;
    color: $text;
}

/* On narrow terminals the side panes collapse and search + now-playing take
   the full width. */
Screen.-narrow #queue-pane,
Screen.-narrow #playlist-pane {
    display: none;
}

TopBar {
    height: 3;
    layout: horizontal;
    align-vertical: middle;
    background: $surface;
    padding: 0 2;
}

#brand {
    width: 1fr;
    content-align: left middle;
    color: $accent-lighten-1;
    text-style: bold;
}

#tagline {
    width: 1fr;
    content-align: left middle;
    color: $text-muted;
}

#queue-count {
    width: auto;
    content-align: right middle;
    color: $text-muted;
}

#body {
    height: 1fr;
}

#results-pane {
    width: 1fr;
}

#queue-pane {
    width: 32;
}

#playlist-pane {
    width: 30;
    border-top: solid $border-blurred;
    border-right: solid $border-blurred;
    border-title-color: $accent;
    border-title-style: bold;
    margin: 0 1 0 0;
    background: $surface;
}

#playlist-pane:focus-within {
    border-top: solid $accent;
    border-right: solid $accent;
}

LibraryTree {
    height: 1fr;
    padding: 0 1;
    background: $surface;
}

LibraryTree > .tree--guides,
LibraryTree > .tree--guides-hover {
    color: $border;
}

LibraryTree > .tree--highlight {
    background: $surface-lighten-1;
}

LibraryTree:focus > .tree--cursor {
    background: $accent;
    color: auto;
    text-style: bold;
}

HistoryList {
    height: 8;
    border-top: solid $border-blurred;
    border-title-color: $accent;
    border-title-style: bold;
    background: $surface;
}

HistoryList > ListItem {
    height: 2;
    padding: 0 1;
    overflow: hidden hidden;
}

HistoryList > ListItem.-highlight {
    background: $accent;
}

HistoryList > ListItem.-highlight .queue-title {
    color: auto;
}

HistoryList > ListItem.-highlight .queue-subtitle {
    color: auto;
}

#search-box {
    height: 1;
    margin: 1 2 0 2;
    padding: 0 1;
    background: $surface;
}

#search-box:focus-within {
    background: $surface-lighten-1;
}

#search-input {
    width: 1fr;
    height: 1;
    background: transparent;
    border: none;
    color: $text;
}

#search-input .input--placeholder {
    color: $text-muted;
}

#search-input:focus {
    background: transparent;
    border: none;
}

#filter-select {
    width: 14;
    height: 1;
    margin-left: 1;
    background: $surface-lighten-1;
}

ResultsTable {
    height: 1fr;
    margin: 1 2;
    border-top: solid $border-blurred;
    background: $background;
}

ResultsTable:focus {
    border-top: solid $accent;
}

ResultsTable > .datatable--header {
    background: $surface-lighten-1;
    color: $text-muted;
    text-style: bold;
}

ResultsTable > .datatable--odd-row {
    background: $surface;
}

ResultsTable > .datatable--cursor {
    background: $accent;
    color: auto;
    text-style: bold;
}

ResultsTable > .datatable--even-row {
    background: $background;
}

QueueList {
    border-top: solid $border-blurred;
    border-left: solid $border-blurred;
    border-title-color: $accent;
    border-title-style: bold;
    margin: 0 0 0 1;
    background: $surface;
}

QueueList:focus {
    border-top: solid $accent;
    border-left: solid $accent;
}

QueueList > ListItem {
    height: 2;
    padding: 0 1;
    overflow: hidden hidden;
}

QueueList > ListItem.-highlight {
    background: $accent;
}

QueueList > ListItem.-highlight .queue-title {
    color: auto;
}

QueueList > ListItem.-highlight .queue-subtitle {
    color: auto;
}

.queue-title {
    height: 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    text-style: bold;
}

.queue-subtitle {
    height: 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    color: $text-muted;
}

.queue-empty {
    color: $text-muted;
    text-style: italic;
}

NowPlaying {
    height: 11;
    background: $surface;
    border-top: solid $border-blurred;
    padding: 0 2;
}

/* Playlist management modal screens: centered dialog over a dimmed main TUI */
ModalScreen {
    align: center middle;
    background: $background 60%;
}

#add-playlist-modal,
#name-modal,
#confirm-modal {
    width: 62;
    max-width: 85%;
    height: auto;
    max-height: 80%;
    background: $surface;
    border: solid $accent;
    border-title-color: $accent;
    border-title-style: bold;
    padding: 1 2;
}

#name-modal-title,
#confirm-modal-message {
    color: $accent-lighten-1;
    text-style: bold;
    margin-bottom: 1;
}

#add-playlist-modal-title {
    height: 1;
    color: $text-muted;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    margin-bottom: 1;
}

#add-playlist-modal-hint {
    color: $text-muted;
}

#add-playlist-modal-empty {
    color: $text-muted;
    margin-bottom: 1;
}

#add-playlist-modal-select {
    height: auto;
    max-height: 18;
    margin-bottom: 1;
    padding: 0;
    border: none;
    background: transparent;
}

#add-playlist-modal-select:focus {
    border: none;
}

#add-playlist-modal-select > .option-list--option-highlighted {
    background: $accent;
    color: auto;
    text-style: bold;
}

#add-playlist-modal-select > .option-list--option-hover {
    background: $surface-lighten-1;
}

#add-playlist-modal-select > .selection-list--button,
#add-playlist-modal-select > .selection-list--button-highlighted {
    background: $surface;
    color: $text-muted;
}

#add-playlist-modal-select > .selection-list--button-selected,
#add-playlist-modal-select > .selection-list--button-selected-highlighted {
    background: $surface;
    color: $accent;
    text-style: bold;
}

#name-modal-input {
    margin-bottom: 1;
}

#name-modal-buttons,
#confirm-modal-buttons {
    height: 1;
    align-horizontal: right;
    margin-bottom: 1;
}

#name-modal-buttons Button,
#confirm-modal-buttons Button {
    height: 1;
    min-width: 10;
    border: none;
    background: transparent;
    color: $text-muted;
    margin-left: 2;
}

#name-modal-buttons Button:focus,
#confirm-modal-buttons Button:focus {
    text-style: bold;
}

#name-modal-buttons #name-modal-save {
    background: $accent;
    color: auto;
    text-style: bold;
}

#confirm-modal-buttons #confirm-modal-yes {
    background: $error;
    color: auto;
    text-style: bold;
}

#name-modal-buttons #name-modal-save:hover {
    background: $accent-lighten-1;
}

#np-head {
    height: 3;
    layout: horizontal;
    align-vertical: middle;
}

#np-icon {
    width: 4;
    content-align: center middle;
    text-style: bold;
    color: $text-muted;
}

#now-playing.has-track #np-icon {
    color: $accent-lighten-1;
}

#now-playing.paused #np-icon {
    color: $warning;
}

#np-meta {
    width: 1fr;
}

#np-title {
    height: 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    text-style: bold;
}

#np-subtitle {
    height: 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    color: $text-muted;
}

#np-time {
    width: auto;
    content-align: right middle;
    color: $text-muted;
}

#np-progress {
    height: 1;
    width: 1fr;
    margin: 0 0 1 0;
}

#np-progress > Bar {
    width: 1fr;
}

#np-foot {
    height: 1;
    layout: horizontal;
}

#np-status {
    width: 1fr;
    color: $text-muted;
}

#np-volume {
    width: auto;
    margin-right: 1;
    color: $text-muted;
}

#np-loop,
#np-auto {
    width: auto;
    margin-right: 1;
    color: $text-muted;
    text-style: bold;
}

#np-loop.on,
#np-auto.on {
    color: $accent-lighten-1;
}

Footer {
    background: $surface-lighten-1;
}

FooterKey {
    color: $accent-lighten-1;
}

FooterLabel {
    color: $text-muted;
}
